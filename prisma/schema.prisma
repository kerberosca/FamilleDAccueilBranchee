generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FAMILY
  RESOURCE
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ResourceVerificationStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ResourcePublishStatus {
  HIDDEN
  PUBLISHED
  SUSPENDED
}

enum ResourceOnboardingState {
  DRAFT
  PENDING_PAYMENT
  PENDING_VERIFICATION
  VERIFIED
  PUBLISHED
  SUSPENDED
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AllyType {
  MENAGE
  GARDIENS
  AUTRES
}

enum BackgroundCheckStatus {
  NOT_REQUESTED
  REQUESTED
  PENDING
  RECEIVED
}

enum ResourceDocumentType {
  CV
  BACKGROUND_CHECK
  RCR_PROOF
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  EXAM_AVAILABLE
  PASSED
  ATTENTION_REQUIRED
}

enum TrainingAssessmentType {
  FORMATIVE
  FINAL
}

enum TrainingReminderType {
  ASSIGNMENT
  DAY_3
  DAY_7
  DAY_14
  SUCCESS
  ATTENTION
}

enum TrainingEmailStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  refreshTokenHash String?
  role             Role
  status           UserStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  familyProfile       FamilyProfile?
  resourceProfile     ResourceProfile?
  subscriptions       Subscription[]
  adminAuditLogs      AdminAuditLog[]      @relation("AdminActor")
  passwordResetTokens PasswordResetToken[]

  sentMessages Message[] @relation("MessageSender")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model FamilyProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  postalCode   String
  city         String
  region       String
  bio          String?
  needsTags    String[]
  availability Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversations Conversation[] @relation("ConversationFamily")
}

model ResourceProfile {
  id                         String                     @id @default(cuid())
  userId                     String                     @unique
  allyType                   AllyType?
  displayName                String
  postalCode                 String
  city                       String
  region                     String
  // Adresse postale (formulaire allié section 1)
  streetAddress              String?
  bio                        String?
  skillsTags                 String[]
  hourlyRate                 Decimal?                   @db.Decimal(10, 2)
  availability               Json?
  verificationStatus         ResourceVerificationStatus @default(DRAFT)
  publishStatus              ResourcePublishStatus      @default(HIDDEN)
  onboardingState            ResourceOnboardingState    @default(DRAFT)
  contactEmail               String?
  contactPhone               String?
  averageRating              Decimal?                   @db.Decimal(3, 2)
  questionnaireAnswers       Json?
  // Formulaire Devenir allié FAB (sections 1-4), JSON
  allyRegistration           Json?
  // Acceptation des déclarations obligatoires (section 4)
  allyDeclarationsAcceptedAt DateTime?
  backgroundCheckStatus      BackgroundCheckStatus      @default(NOT_REQUESTED)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversations       Conversation[]       @relation("ConversationResource")
  documents           ResourceDocument[]
  trainingEnrollments TrainingEnrollment[]
}

model TrainingEnrollment {
  id                String         @id @default(cuid())
  resourceProfileId String
  courseVersion     String         @default("faba-v1")
  status            TrainingStatus @default(NOT_STARTED)
  currentLessonKey  String?
  assignedAt        DateTime       @default(now())
  startedAt         DateTime?
  lastActivityAt    DateTime?
  completedAt       DateTime?
  attemptsResetAt   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  resourceProfile ResourceProfile             @relation(fields: [resourceProfileId], references: [id], onDelete: Cascade)
  lessonProgress  TrainingLessonProgress[]
  attempts        TrainingAssessmentAttempt[]
  certificate     TrainingCertificate?
  emailLogs       TrainingEmailLog[]

  @@unique([resourceProfileId, courseVersion])
  @@index([status, assignedAt])
  @@index([lastActivityAt])
}

model TrainingLessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonKey    String
  visitedAt    DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonKey])
  @@index([enrollmentId, completedAt])
}

model TrainingAssessmentAttempt {
  id            String                 @id @default(cuid())
  enrollmentId  String
  type          TrainingAssessmentType
  attemptNumber Int
  answers       Json
  scorePercent  Int
  passed        Boolean
  submittedAt   DateTime               @default(now())

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, type, attemptNumber])
  @@index([enrollmentId, type, submittedAt])
}

model TrainingCertificate {
  id              String   @id @default(cuid())
  enrollmentId    String   @unique
  certificateCode String   @unique
  participantName String
  courseTitle     String
  courseVersion   String
  scorePercent    Int
  issuedAt        DateTime @default(now())

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model TrainingEmailLog {
  id                String               @id @default(cuid())
  enrollmentId      String
  type              TrainingReminderType
  status            TrainingEmailStatus  @default(PENDING)
  scheduledFor      DateTime
  sentAt            DateTime?
  processingAt      DateTime?
  providerMessageId String?
  retryCount        Int                  @default(0)
  lastError         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, type])
  @@index([status, scheduledFor])
}

model ResourceDocument {
  id                String               @id @default(cuid())
  resourceProfileId String
  type              ResourceDocumentType
  originalName      String
  storedName        String
  mimeType          String
  sizeBytes         Int
  uploadedAt        DateTime             @default(now())
  deletedAt         DateTime?

  resourceProfile ResourceProfile @relation(fields: [resourceProfileId], references: [id], onDelete: Cascade)

  @@index([resourceProfileId])
  @@index([type])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  status               SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id         String   @id @default(cuid())
  familyId   String
  resourceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  family   FamilyProfile   @relation("ConversationFamily", fields: [familyId], references: [id], onDelete: Cascade)
  resource ResourceProfile @relation("ConversationResource", fields: [resourceId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([familyId, resourceId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  payload     Json?
  createdAt   DateTime @default(now())

  actorUser User @relation("AdminActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model MaintenanceState {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}
