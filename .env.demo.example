# Copier en .env.demo (fichier ignoré par Git), puis générer trois secrets différents.
# Le mot de passe PostgreSQL doit contenir uniquement des caractères sûrs pour une URL, par exemple de l'hexadécimal.
DEMO_POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_HEXADECIMAL
JWT_ACCESS_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DIFFERENT
JWT_REFRESH_SECRET=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE

# Requis par la configuration de l'API; aucun administrateur n'est créé par le seed démo.
ADMIN_EMAIL=administrateur@demo.invalid
ADMIN_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE

# Valeurs explicites pour éviter de réutiliser la configuration du site principal.
DEMO_MODE=true
NODE_ENV=production
DEV_BYPASS_AUTH=false
EMAIL_DELIVERY_MODE=log
STRIPE_BILLING_MODE=DISABLED
STRIPE_CHECKOUT_ENABLED=false
N8N_ALLY_WEBHOOK_URL=
